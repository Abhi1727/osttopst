# ================================
# DATABASE CONFIGURATION
# ================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=pstconverter_db
MYSQL_USER=pstconverter_user
MYSQL_PASSWORD=your_secure_mysql_password_here

# ================================
# REDIS CONFIGURATION (Optional)
# ================================
REDIS_PASSWORD=your_secure_redis_password_here

# ================================
# CLERK AUTHENTICATION
# ================================
# Backend Secret Key (Keep this SECRET!)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Authority URL
CLERK_AUTHORITY=https://your-clerk-instance.clerk.accounts.dev

# Frontend Publishable Key (Safe to expose)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ================================
# FRONTEND CONFIGURATION
# ================================
# For production, this should be your public API URL
# Example: https://api.yourdomain.com or https://yourdomain.com/api
VITE_API_URL=http://localhost:5000

# ================================
# APPLICATION CONFIGURATION
# ================================
# Environment mode
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Ports (if you want to customize)
# FRONTEND_PORT=3000
# BACKEND_PORT=5000
# MYSQL_PORT=3306
# REDIS_PORT=6379

# ================================
# LICENSE API CONFIGURATION
# ================================
# URL of the license server
# Example: http://localhost:5001/ or http://192.168.0.200:5001/
LicenseApi__BaseUrl=http://localhost:5001/
LicenseApi__Username=admin
LicenseApi__Password=1234
LicenseApi__UserId=test
LicenseApi__ToolId=1
LicenseApi__ModuleId=1

# ================================
# ASPOSE EMAIL LICENSE (Optional)
# ================================
# If you have an Aspose.Email license file:
# 1. Place it in: backend/PstConverter.API/Aspose.Email.lic
# 2. Uncomment the volume mount in docker-compose.yml

# ================================
# PRODUCTION DEPLOYMENT NOTES
# ================================
# 1. Replace all placeholder values with actual secrets
# 2. Use strong, randomly generated passwords
# 3. Never commit .env file to version control
# 4. Use a secrets manager in production (AWS Secrets Manager, Azure Key Vault, etc.)
# 5. For cloud deployments, configure VITE_API_URL to your actual API domain
