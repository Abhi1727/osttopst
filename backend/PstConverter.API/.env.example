# Backend database connection (remote MySQL on Hostinger or elsewhere)
# Replace the placeholders with your real values and copy this file to
# /opt/osttopst/backend/.env on the server as needed.

# Example remote MySQL connection string
# Common Hostinger-style host examples:
#   mysql.hostinger.com
#   your-db-host.region.hostinger.com

ConnectionStrings__DefaultConnection=Server=your-mysql-hostname;Port=3306;Database=pstconverter_db;User=your_db_username;Password=your_db_password;SslMode=Preferred

# Clerk backend configuration (must match your Clerk project)
Clerk__SecretKey=sk_test_your_clerk_secret_key_here
Clerk__Authority=https://your-clerk-instance.clerk.accounts.dev
Server=tcp:shefw.database.windows.net,1433;Database=Shefw;User Id=shefsql;Password=Xziant@db.com;TrustServerCertificate=True;
